# Copy to .env and fill in every required value. Never commit .env.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
SUPPORT_ROLE_ID=
TICKET_CATEGORY_ID=
TRANSCRIPT_CHANNEL_ID=
RATING_CHANNEL_ID=
ESCALATION_ROLE_ID=
DUPLICATE_APPROVAL_CHANNEL_ID=

# Optional branding and storage (relative to the bot folder, or absolute).
BRAND_NAME=TicketCore
DATABASE_FILE=ticketcore-tickets.sqlite

# Optional timings and duplicate detection.
TICKET_DUPLICATE_LOOKBACK_DAYS=30
TICKET_DUPLICATE_SIMILARITY_THRESHOLD=0.60
TICKET_INACTIVITY_WARN_HOURS=48
TICKET_INACTIVITY_CLOSE_HOURS=72
TICKET_INACTIVITY_CHECK_MINUTES=10
TICKET_REOPEN_WINDOW_HOURS=48
